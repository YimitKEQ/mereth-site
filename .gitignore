node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Local env. Discord client secret and the staff session secret live here.
.env
.env.*
!.env.example

# Screenshots of somebody else's site, kept only as a design reference while the
# layout is being matched. Not ours to redistribute, so they stay out of git.
reference/

# Output of the screenshot compare loop.
shots/

# Scratch output from CSS inspection.
*.tmp

# Commercial typeface supplied locally for the prototype. Not ours to
# redistribute, so it stays on this machine and out of the repo.
src/fonts/
*.zip

# Their background plate is 24 MB of video. Local only, never in history.
public/art/*.mp4

# Raw captures. The screenshots in MerethPics are small enough to keep, and are
# the source the image build reads. Video out of the game is not: one 28 second
# clip arrives at 74 MB, and git keeps every version of it forever. The encoded
# result is what ships, and `scripts/build-video.mjs` is the recipe for making it
# again from a file kept outside this repository.
MerethPics/*.mp4
MerethPics/*.mov
MerethPics/*.gif
.gstack/

# The source legal documents. The site renders them; the authoritative copies
# live in the launcher and Discord.
*.docx

# Knowledge graph. Rebuilt by `npm run graph` in the parent mod workspace. Only
# semantic.json is kept: it holds the concepts extracted from the docs and the Lore
# PDFs by an LLM, which is the one part that costs tokens to reproduce.
graphify-out/*
!graphify-out/semantic.json
!graphify-out/semantic-sources.json
